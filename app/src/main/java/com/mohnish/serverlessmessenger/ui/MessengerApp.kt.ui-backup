private enum class Screen {
    Welcome,
    Identity,
    AddContact,
    Chats,
    Chat,
    Settings
}

private data class Message(
    val id: String,
    val text: String,
    val mine: Boolean,
    val time: String,
    val timestamp: Long
)

@Composable
fun MessengerApp() {
    val context = LocalContext.current
    val appScope = rememberCoroutineScope()

    val messageStore =
        remember { MessageStore(context) }

    val contactStore =
        remember { ContactStore(context) }

    val contactDirectory =
        remember {
            ContactDirectory(
                contactStore = contactStore,
                scope = appScope
            )
        }

    val signaling =
        remember {
            NostrPeerSignaling(
                context = context,
                contactDirectory = contactDirectory
            )
        }

    val peerConnectionManager =
        remember {
            PeerConnectionManager(
                context = context,
                messageStore = messageStore,
                signaling = signaling,
                scope = appScope
            )
        }

    val profileStore = remember { ProfileStore(context) }
    val appSettingsStore = remember { AppSettingsStore(context) }

    val savedUsername by profileStore.username.collectAsState(initial = "")
    val developerMode by appSettingsStore.developerMode.collectAsState(initial = false)

    var screen by remember { mutableStateOf<Screen?>(null) }
    var activeContact by remember { mutableStateOf("Alex") }

    LaunchedEffect(savedUsername) {
        if (screen == null) {
            screen =
                if (savedUsername.isBlank()) {
                    Screen.Welcome
                } else {
                    Screen.Chats
                }
        }
    }

    when (val currentScreen = screen) {
        null -> {
            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .background(AppWhite)
            )
        }

        Screen.Welcome -> WelcomeScreen {
            screen = Screen.Identity
        }

        Screen.Identity -> IdentityScreen(
            signaling = signaling,
            developerMode = developerMode,
            onBack = { screen = Screen.Welcome },
            onAddContact = { screen = Screen.AddContact },
            onContinue = { screen = Screen.Chats }
        )

        Screen.AddContact -> AddContactScreen(
            onBack = { screen = Screen.Identity },
            onDone = { screen = Screen.Chats }
        )

        Screen.Chats -> ChatsScreen(
            onAdd = { screen = Screen.AddContact },
            onSettings = { screen = Screen.Settings },
            onOpen = {
                activeContact = it
                screen = Screen.Chat
            }
        )

        Screen.Chat -> ChatScreen(
            identityId = activeContact,
            peerConnectionManager = peerConnectionManager,
            developerMode = developerMode,
            onBack = { screen = Screen.Chats }
        )

        Screen.Settings -> SettingsScreen(
            developerMode = developerMode,
            onDeveloperModeChanged = { enabled ->
                appScope.launch {
                    appSettingsStore.setDeveloperMode(enabled)
                }
            },
            onBack = { screen = Screen.Chats }
        )
    }
}

